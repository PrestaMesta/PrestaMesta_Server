NODE_ENV=development
PORT=3000

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=prestamesta

MONGO_URI=mongodb://127.0.0.1:27017/prestamesta

# Genera un valor propio de al menos 32 caracteres de alta entropia, por ejemplo:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Nunca reutilices el mismo valor entre entornos de test y de produccion.
JWT_SECRET=
JWT_EXPIRES_IN=8h
JWT_ISS=prestamesta-api
JWT_AUD_CLIENTE=prestamesta-client
JWT_AUD_ADMIN=prestamesta-admin

CORS_ORIGINS=http://localhost:4200,http://localhost:8100

# Rate limit especifico de POST /prestamos/solicitar (no comparte el limite de login).
# Valores por defecto: 10 solicitudes por hora por IP.
SOLICITUD_RATE_LIMIT_WINDOW_MS=3600000
SOLICITUD_RATE_LIMIT_MAX=10
