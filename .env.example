NODE_ENV=development
PORT=3000

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=prestamesta

MONGO_URI=mongodb://127.0.0.1:27017/prestamesta

# Genera un valor propio de al menos 32 caracteres de alta entropia, por ejemplo:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Nunca reutilices el mismo valor entre entornos de test y de produccion.
JWT_SECRET=
JWT_EXPIRES_IN=8h
JWT_ISS=prestamesta-api
JWT_AUD_CLIENTE=prestamesta-client
JWT_AUD_ADMIN=prestamesta-admin
# Audiencias del token temporal previo al MFA (Checkpoint 6B-2), distintas de las de sesion.
JWT_AUD_CLIENTE_PRE_MFA=prestamesta-client-pre-mfa
JWT_AUD_ADMIN_PRE_MFA=prestamesta-admin-pre-mfa

# Rate limit de login/registro (defaults: 20 intentos por 15 minutos por IP).
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20

CORS_ORIGINS=http://localhost:4200,http://localhost:8100

# Rate limit especifico de POST /prestamos/solicitar (no comparte el limite de login).
# Valores por defecto: 10 solicitudes por hora por IP.
SOLICITUD_RATE_LIMIT_WINDOW_MS=3600000
SOLICITUD_RATE_LIMIT_MAX=10

# --- MFA (Checkpoint 6B-1: infraestructura de persistencia/cifrado, todavia sin conectar) ---

# Clave AES-256-GCM (base64 estandar, debe decodificar a exactamente 32 bytes) para cifrar
# el secreto TOTP en reposo. Genera un valor propio, por ejemplo:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Nunca reutilices el mismo valor entre entornos de test y de produccion, igual que JWT_SECRET.
MFA_ENCRYPTION_KEY_BASE64=

# TTL del token temporal previo al MFA y del token de step-up (todavia no se emiten).
PRE_MFA_EXPIRES_IN=5m
STEP_UP_EXPIRES_IN=2m

# Rate limit especifico de los endpoints MFA que aceptan un codigo de 6 digitos
# (mfa/verify, mfa/enroll/confirm).
MFA_RATE_LIMIT_WINDOW_MS=600000
MFA_RATE_LIMIT_MAX=5
